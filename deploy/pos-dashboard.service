[Unit]
Description=POS Dashboard Web
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=admin1
WorkingDirectory=/home/admin1/posbottieuhiem
# Repo hiện chỉ có pos-dashboard.env.example; dùng file example để web tự chạy sau reboot.
EnvironmentFile=/home/admin1/posbottieuhiem/deploy/pos-dashboard.env.example
ExecStart=/home/admin1/posbottieuhiem/run_web_vps.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
