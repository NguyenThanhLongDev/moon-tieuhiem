# Cookie + IMEI + UA của TÀI KHOẢN "Trợ lý Lan" (Zalo riêng cho bot).
# Cách lấy: cài extension "ZaloDataExtractor"
# (https://github.com/JustKemForFun/ZaloDataExtractor) trên Chrome,
# đăng nhập Zalo Web bằng account Lan, ấn extension → copy 3 giá trị.

ZALO_COOKIES='[{"name":"...", "value":"...", "domain":".zalo.me", ...}]'
ZALO_IMEI=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZALO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 ...

# Backend endpoint
FLASK_URL=http://localhost:5050/api/zalo-bridge/inbound
BRIDGE_SECRET=doi-secret-nay-thanh-random-string-dai

# Whitelist group thread_id (CSV). Để trống = nghe tất cả group account Lan ở trong.
# Lấy thread_id: in console của bridge khi NV gửi tin thử.
ALLOWED_GROUPS=
