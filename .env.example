# ============================================================
# POSBOT TIỂU HIỀM — Cấu hình môi trường
# Copy file này thành .env và điền thông tin thực tế:
#   cp .env.example .env
# ============================================================

# ──────────────────────────────────────────────────────────────
# DATABASE — BẮT BUỘC
# ──────────────────────────────────────────────────────────────
# VPS/Local PostgreSQL:
DATABASE_URL=postgresql://postgres:MAT_KHAU@localhost:5432/tieuhiem_pos

# ──────────────────────────────────────────────────────────────
# APP SECURITY — BẮT BUỘC (đổi thành chuỗi ngẫu nhiên dài)
# ──────────────────────────────────────────────────────────────
POS_DASHBOARD_SECRET=doi-thanh-chuoi-bi-mat-ngau-nhien-dai-it-nhat-32-ky-tu
SESSION_SECRET=doi-thanh-chuoi-bi-mat-khac

# ──────────────────────────────────────────────────────────────
# TÀI KHOẢN ĐĂNG NHẬP APP (admin mặc định)
# ──────────────────────────────────────────────────────────────
POS_DASHBOARD_USERNAME=admin
POS_DASHBOARD_PASSWORD=doi-mat-khau-cua-ban

# ──────────────────────────────────────────────────────────────
# PORT & VERSION
# ──────────────────────────────────────────────────────────────
PORT=8000
POS_DASHBOARD_WEB_VERSION=2.5

# ──────────────────────────────────────────────────────────────
# TIMEZONE
# ──────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh

# ──────────────────────────────────────────────────────────────
# FACEBOOK ADS (không bắt buộc — chỉ cần nếu dùng tính năng quảng cáo)
# ──────────────────────────────────────────────────────────────
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v20.0

# ──────────────────────────────────────────────────────────────
# AUTO-SYNC INTERVALS (giây) — có thể để mặc định
# ──────────────────────────────────────────────────────────────
ORDER_STATUS_SYNC_INTERVAL_SECONDS=720
ORDER_STATUS_SYNC_INITIAL_DELAY_SECONDS=10
LIVE_STATUS_SYNC_INTERVAL_SECONDS=900
LIVE_STATUS_SYNC_INITIAL_DELAY_SECONDS=30
POS_DAILY_SYNC_INTERVAL_SECONDS=3600
POS_DAILY_SYNC_INITIAL_DELAY_SECONDS=60

# Tắt auto-sync (1=tắt, 0=bật)
ORDER_STATUS_SYNC_DISABLED=0
LIVE_STATUS_SYNC_DISABLED=0
POS_DAILY_SYNC_DISABLED=0

# ──────────────────────────────────────────────────────────────
# PERFORMANCE
# ──────────────────────────────────────────────────────────────
WEB_PANCAKE_PARALLEL_WORKERS=8
WEB_APP_DEBUG=0
